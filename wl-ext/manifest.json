{
  "manifest_version": 3,
  "name": "ChromeBoost - Memory & Performance Optimizer",
  "version": "2.2.9",
  "description": "Speeds up Chrome by managing tab memory, reducing RAM usage, and optimizing background processes.",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "scripting",
    "idle",
    "identity",
    "identity.email",
    "notifications",
    "browsingData",
    "webNavigation"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChromeBoost - Memory Optimizer",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}